# HCG Store server: LOCAL DEVELOPMENT against the real HCG Connect, with the development client.
# Not secret: public client, no client secret. Never use this file for production; the server
# refuses this client ID in production mode (server/src/config.ts, DEVELOPMENT_CLIENT_IDS).
# Start with `npm run hcg:dev` (it adds a local session key that is never committed).
# See docs/HCG-CONNECT-DEV.md.

# "test" mode is what allows the loopback http:// callback. Test payments and the test ledger are
# NOT enabled here: purchases and protected downloads stay off.
HCG_STORE_MODE=test
HCG_STORE_PUBLIC_ORIGIN=http://127.0.0.1:8787
HOST=127.0.0.1
PORT=8787
HCG_STORE_STATIC_DIR=dist
HCG_STORE_DATA_DIR=.hcg-dev/data

# HCG Connect (identity-provider contract from the main-site handoff, 16 Nov 2026)
HCG_CONNECT_ISSUER=https://qggdyzoydveafkmjgkpq.supabase.co/auth/v1
HCG_CONNECT_AUTHORIZATION_ENDPOINT=https://qggdyzoydveafkmjgkpq.supabase.co/auth/v1/oauth/authorize
HCG_CONNECT_TOKEN_ENDPOINT=https://qggdyzoydveafkmjgkpq.supabase.co/auth/v1/oauth/token
HCG_CONNECT_JWKS_URI=https://qggdyzoydveafkmjgkpq.supabase.co/auth/v1/.well-known/jwks.json
# Integration key hcg-store-web-development (product hcg.store), status configured_untested
HCG_CONNECT_CLIENT_ID=af487795-ead1-4671-8b09-76301762ee2c
HCG_CONNECT_REDIRECT_URI=http://127.0.0.1:8787/auth/callback
HCG_CONNECT_SCOPES=openid email profile

# Ecosystem API: /me confirms the signed-in account; /check is read-only
HCG_ECOSYSTEM_API_URL=https://beta.hakmicapitalgroup.com/api/public/ecosystem/v1
HCG_STORE_ENTITLEMENT_AUTHORITY=hcg-ecosystem

# Off pending their own verification
HCG_STORE_PAYMENT_PROVIDER=none
HCG_STORE_PROTECTED_DOWNLOADS=disabled

# Re-confirm the HCG session (refresh, with rotation) every 20 s, so the refresh check is quick
HCG_STORE_SESSION_RECHECK_SECONDS=20
