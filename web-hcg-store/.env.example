# HCG Store — environment configuration (EXAMPLE, placeholders only)
#
# Copy to `.env.local` for local overrides. Never commit real values.
#
# IMPORTANT: every variable starting with VITE_ is embedded in the PUBLIC JavaScript bundle.
# Never put secrets here (client secrets, service-role keys, API tokens, Dropbox tokens).
# The build refuses VITE_ variables whose names look like credentials
# (…SECRET…, …TOKEN…, …PASSWORD…, …PRIVATE…, …SERVICE_ROLE…, …API_KEY…).

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------
# development | preview | production. Anything other than "production" is always noindex.
VITE_DEPLOY_ENV=development

# Public origin of THIS deployment (scheme + host, no path). Optional.
# Used only for canonical URLs and the sitemap, and only when indexing is allowed.
# Local:   http://localhost:5173
# Preview: https://<your-preview-host>
# The future domain https://store.hakmicapitalgroup.com is NOT live yet; the build rejects it
# unless VITE_DEPLOY_ENV=production is set explicitly.
VITE_PUBLIC_ORIGIN=

# "true" enables search-engine indexing — honoured ONLY when VITE_DEPLOY_ENV=production and
# VITE_PUBLIC_ORIGIN is set. Leave empty until the founder approves going live.
VITE_ALLOW_INDEXING=

# ---------------------------------------------------------------------------
# Catalogue provider
# ---------------------------------------------------------------------------
# local   = validated seed files in catalogue/ (default, provisional)
# hcg-erp = read-only public catalogue endpoint from HCG ERP (contract pending founder review)
VITE_CATALOGUE_PROVIDER=local
# Public, read-only HTTPS endpoint. No credentials are sent from the browser.
VITE_HCG_ERP_CATALOGUE_URL=

# ---------------------------------------------------------------------------
# HCG Connect (central identity) — leave ALL empty until the contract is approved.
# With nothing set, the store shows "HCG Connect not configured" and makes no auth requests.
# Even when set, sign-in stays disabled until a reviewed protocol implementation is added.
# ---------------------------------------------------------------------------
VITE_HCG_CONNECT_CONTRACT_VERSION=
VITE_HCG_CONNECT_AUTHORIZATION_ENDPOINT=   # https://<central>/<authorize>
VITE_HCG_CONNECT_TOKEN_ENDPOINT=           # https://<central>/<token>
VITE_HCG_CONNECT_REVOCATION_ENDPOINT=      # https://<central>/<revoke>
VITE_HCG_CONNECT_APP_ACCESS_ENDPOINT=      # https://<central>/<app-access>
VITE_HCG_CONNECT_CLIENT_ID=                # PUBLIC client id registered for HCG Store (not another app's)
VITE_HCG_CONNECT_REDIRECT_URI=             # must be on the origin serving this build
VITE_HCG_CONNECT_SCOPES=                   # space-separated, as approved centrally
VITE_HCG_CONNECT_APP_IDENTIFIER=           # HCG Store id in the App Access registry
VITE_HCG_CONNECT_APPROVED_BY_FOUNDER=      # "true" only after founder approval

# ---------------------------------------------------------------------------
# Build-time only (not VITE_, never embedded in the bundle)
# ---------------------------------------------------------------------------
# HCG_BASE_PATH=/            # serve from a sub-path, e.g. /store/
# HCG_CATALOGUE_DIR=catalogue
# HCG_OUT_DIR=dist
