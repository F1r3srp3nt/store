# HCG Store SERVER configuration (EXAMPLE, placeholders only). Never commit real values.
# These are server-side environment variables: they are NOT embedded in the browser bundle.
# Defaults are closed: without changes the server runs with no sign-in, no payments and no
# protected downloads, and every product page says "Downloads are not available yet."
# See docs/ACCESS.md, docs/PAYMENTS.md and docs/DEPLOYMENT.md.

# production (default) | test. Test mode allows the TEST payment provider and TEST entitlement
# ledger, and must never face real customers.
HCG_STORE_MODE=production

# Public origin of this Store (scheme + host). https required in production.
HCG_STORE_PUBLIC_ORIGIN=https://<store-host>
# 32 random bytes, base64. Seals stored HCG tokens and signs short-lived download URLs.
# Generate with: openssl rand -base64 32   (keep it in the host's secret store)
HCG_STORE_SECRET_KEY=
PORT=8787
HOST=127.0.0.1
HCG_STORE_DATA_DIR=data                 # SQLite file for sessions, purchases and payment events
HCG_STORE_STATIC_DIR=dist               # the built storefront

# HCG Repo website origin(s) allowed to read access state with the Store cookie (CORS).
HCG_STORE_REPO_ORIGINS=https://repo.hakmicapitalgroup.com

# --- HCG Connect (central identity). Leave ALL empty until HCG issues HCG Store's client. ---
# The client ID is PUBLIC (no client secret is used or accepted). Do not reuse another app's client.
HCG_CONNECT_ISSUER=                     # https://<project>.supabase.co/auth/v1  (exact issuer)
HCG_CONNECT_AUTHORIZATION_ENDPOINT=     # <issuer>/oauth/authorize
HCG_CONNECT_TOKEN_ENDPOINT=             # <issuer>/oauth/token
HCG_CONNECT_JWKS_URI=                   # <issuer>/.well-known/jwks.json
HCG_CONNECT_CLIENT_ID=                  # issued centrally by HCG for HCG Store (web)
HCG_CONNECT_REDIRECT_URI=               # https://<store-host>/auth/callback (registered exactly)
HCG_CONNECT_SCOPES=openid email profile
HCG_STORE_SESSION_RECHECK_SECONDS=60    # max age of the last central session confirmation for protected actions

# --- Entitlements (owned by HCG). none | hcg-ecosystem | test-ledger (test mode only) ---
HCG_STORE_ENTITLEMENT_AUTHORITY=none
HCG_ECOSYSTEM_API_URL=                  # https://beta.hakmicapitalgroup.com/api/public/ecosystem/v1 (see docs/MAIN-SITE-HANDOFF-REQUEST.md)

# Central purchase grants (decision D5). PROPOSED endpoint, not deployed. Leave both empty until HCG
# issues a credential. The environment (test/production) is this server's HCG_STORE_MODE; HCG binds
# the credential to it. Put the credential only in the server's secret store, never in a file or log.
HCG_STORE_GRANT_API_URL=
HCG_STORE_GRANT_CREDENTIAL=

# --- Payments. none | test (test mode only). No live provider is implemented or approved. ---
HCG_STORE_PAYMENT_PROVIDER=none
HCG_STORE_TEST_PAYMENT_WEBHOOK_SECRET=  # test mode only; random if empty

# --- Protected downloads: the LAUNCH SWITCH. Leave disabled. ---
# Enabling in production also requires HCG Connect, an entitlement authority, private storage and
# HCG_STORE_LAUNCH_APPROVED=founder-approved, set only after the founder approves launch.
HCG_STORE_PROTECTED_DOWNLOADS=disabled
HCG_STORE_LAUNCH_APPROVED=
HCG_STORE_ARTIFACT_STORAGE_DIR=         # PRIVATE directory, never inside dist/ or any public site
HCG_STORE_DOWNLOAD_URL_TTL_SECONDS=120  # lifetime of short-lived Sileo download URLs

# Server-side registries (prices and protected files). Both are empty on purpose.
HCG_STORE_OFFERS_FILE=server/data/offers.json
HCG_STORE_ARTIFACTS_FILE=server/data/artifacts.json
HCG_CATALOGUE_DIR=catalogue
