{
  "name": "hcg-store-web",
  "private": true,
  "version": "0.1.0",
  "description": "HCG Store \u2014 web storefront for Hakmi Capital Group applications and developer tools.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run validate:catalogue && tsc -b && vite build && node scripts/check-bundle-secrets.mjs dist",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "validate:catalogue": "tsx scripts/validate-catalogue.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:fixture": "HCG_CATALOGUE_DIR=tests/fixtures/catalogue-demo HCG_OUT_DIR=dist-fixture VITE_FIXTURE_MODE=true vite build",
    "test:e2e": "playwright test",
    "check:secrets": "node scripts/check-bundle-secrets.mjs dist",
    "verify:artifact": "tsx scripts/verify-artifact.ts",
    "check": "npm run validate:catalogue && npm run typecheck && npm test && npm run build",
    "test:e2e:full": "npm run build && npm run build:fixture && playwright test",
    "screenshots": "HCG_CAPTURE_SCREENSHOTS=1 playwright test e2e/screenshots.spec.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.1.0"
  }
}
